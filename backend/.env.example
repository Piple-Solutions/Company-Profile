# PipleSolution backend — local development ONLY. Placeholders, never real secrets.
# Copy to backend/.env (gitignored) and fill locally. Production uses deployment secret stores.
PORT=8787
DATABASE_FILE=./dev.db
# High-entropy bootstrap token, generated out-of-band. Example generation:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the GENERATED value here (this file shows a placeholder, not a secret).
BOOTSTRAP_TOKEN=[PASTE_GENERATED_64_HEX_CHARS_HERE]
SESSION_SECRET=[PASTE_GENERATED_64_HEX_CHARS_HERE]
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
